{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xmuoj.example/schemas/problem-import-report-v1.schema.json",
  "title": "XMUOJ-AI problem import report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "status", "generated_at", "summary", "problems"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "status": {"enum": ["uploaded", "validating", "validated", "importing", "imported", "partial", "failed", "cancelled"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "valid", "warnings", "errors", "duplicates", "imported", "skipped"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "valid": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "duplicates": {"type": "integer", "minimum": 0},
        "imported": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0}
      }
    },
    "problems": {"type": "array", "items": {"$ref": "#/$defs/problemResult"}}
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "code", "field", "message"],
      "properties": {
        "level": {"enum": ["fatal", "error", "warning", "info"]},
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "field": {"type": ["string", "null"], "maxLength": 300},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "problemResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "line_number", "problem_key", "source_platform", "source_id", "status", "issues"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "description": "CollectedProblem.id"},
        "line_number": {"type": "integer", "minimum": 1},
        "problem_key": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,150}$"},
        "source_platform": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,49}$"},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "status": {"enum": ["pending", "validated", "duplicate", "ready", "importing", "imported", "failed", "skipped"]},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}
      }
    }
  }
}
