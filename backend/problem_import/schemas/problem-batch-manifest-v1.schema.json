{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xmuoj.example/schemas/problem-batch-manifest-v1.schema.json",
  "title": "XMUOJ-AI QDUOJ-compatible batch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "batch_id", "generated_at", "producer", "source_platforms", "problem_count", "importable_count", "problems", "files"],
  "properties": {
    "format": {"const": "xmuoj-qduoj-batch"},
    "schema_version": {"const": "1.0.0"},
    "batch_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
        "contact": {"type": "string", "minLength": 1, "maxLength": 100}
      }
    },
    "source_platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,49}$"}
    },
    "problem_count": {"type": "integer", "minimum": 0},
    "importable_count": {"type": "integer", "minimum": 0},
    "problems": {
      "type": "array",
      "items": {"$ref": "#/$defs/problemEntry"}
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/fileEntry"}
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
      "maxLength": 500
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "size_bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safePath"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 100},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 2147483648},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "problemEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_key", "metadata_line", "directory", "delivery_status", "metadata_path"],
      "properties": {
        "problem_key": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,150}$"},
        "metadata_line": {"type": "integer", "minimum": 1},
        "directory": {"type": ["string", "null"], "pattern": "^[1-9][0-9]*$"},
        "delivery_status": {"enum": ["ready", "statement_only", "needs_review"]},
        "metadata_path": {"const": "metadata/problems.jsonl"}
      },
      "allOf": [
        {
          "if": {"properties": {"delivery_status": {"const": "ready"}}, "required": ["delivery_status"]},
          "then": {"properties": {"directory": {"type": "string"}}},
          "else": {"properties": {"directory": {"type": "null"}}}
        }
      ]
    }
  }
}
