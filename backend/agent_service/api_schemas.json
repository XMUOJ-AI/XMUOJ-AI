{
  "CreateRunRequest": {
    "oneOf": [
      {
        "$ref": "#/definitions/SubmissionFeedbackRunRequest"
      },
      {
        "$ref": "#/definitions/CodeExplanationRunRequest"
      },
      {
        "$ref": "#/definitions/SocraticHintRunRequest"
      },
      {
        "$ref": "#/definitions/LearningPathExplanationRunRequest"
      }
    ]
  },
  "SubmissionFeedbackRunRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "service_type",
      "submission_id",
      "options"
    ],
    "properties": {
      "service_type": {
        "type": "string",
        "enum": [
          "submission_feedback"
        ]
      },
      "submission_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "options": {
        "$ref": "#/definitions/RunOptions"
      }
    }
  },
  "CodeExplanationRunRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "service_type",
      "submission_id",
      "options"
    ],
    "properties": {
      "service_type": {
        "type": "string",
        "enum": [
          "code_explanation"
        ]
      },
      "submission_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "options": {
        "$ref": "#/definitions/RunOptions"
      }
    }
  },
  "SocraticHintRunRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "service_type",
      "problem_id",
      "conversation_id",
      "student_explanation",
      "options"
    ],
    "properties": {
      "service_type": {
        "type": "string",
        "enum": [
          "socratic_hint"
        ]
      },
      "problem_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "description": "XMUOJ Problem._id 展示编号。"
      },
      "conversation_id": {
        "type": "string",
        "format": "uuid"
      },
      "student_explanation": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "options": {
        "$ref": "#/definitions/RunOptions"
      }
    }
  },
  "LearningPathExplanationRunRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "service_type",
      "options"
    ],
    "properties": {
      "service_type": {
        "type": "string",
        "enum": [
          "learning_path_explanation"
        ]
      },
      "path_id": {
        "type": "string",
        "format": "uuid",
        "description": "缺省时读取当前用户的活动路径。"
      },
      "options": {
        "$ref": "#/definitions/RunOptions"
      }
    }
  },
  "RunOptions": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "language"
    ],
    "properties": {
      "language": {
        "type": "string",
        "enum": [
          "zh-CN"
        ]
      },
      "detail_level": {
        "type": "string",
        "enum": [
          "brief",
          "normal"
        ]
      }
    }
  },
  "RunEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "error",
      "data",
      "request_id"
    ],
    "properties": {
      "error": {
        "type": [
          "string",
          "null"
        ]
      },
      "data": {
        "$ref": "#/definitions/Run"
      },
      "request_id": {
        "type": "string"
      }
    }
  },
  "Run": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "run_id",
      "service_type",
      "status",
      "cached",
      "result",
      "created_time"
    ],
    "properties": {
      "run_id": {
        "type": "string",
        "format": "uuid"
      },
      "service_type": {
        "type": "string",
        "enum": [
          "submission_feedback",
          "code_explanation",
          "socratic_hint",
          "learning_path_explanation"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "blocked",
          "cancelled"
        ]
      },
      "cached": {
        "type": "boolean"
      },
      "result": {
        "description": "具体结构由 service_type 决定，完成前为 null。",
        "oneOf": [
          {
            "type": [
              "object",
              "null"
            ],
            "enum": [
              null
            ]
          },
          {
            "$ref": "#/definitions/SubmissionFeedbackResult"
          },
          {
            "$ref": "#/definitions/CodeExplanationResult"
          },
          {
            "$ref": "#/definitions/SocraticHintResult"
          },
          {
            "$ref": "#/definitions/LearningPathExplanationResult"
          }
        ]
      },
      "error_detail": {
        "oneOf": [
          {
            "$ref": "#/definitions/RunErrorDetail"
          },
          {
            "type": [
              "object",
              "null"
            ],
            "enum": [
              null
            ]
          }
        ]
      },
      "created_time": {
        "type": "string",
        "format": "date-time"
      },
      "started_time": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "finished_time": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      }
    }
  },
  "RunErrorDetail": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "code",
      "message",
      "retryable",
      "details"
    ],
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]+$"
      },
      "message": {
        "type": "string"
      },
      "retryable": {
        "type": "boolean"
      },
      "details": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "LikelyCause": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "cause",
      "confidence",
      "check_first"
    ],
    "properties": {
      "cause": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "check_first": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "SubmissionFeedbackResult": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "verdict_summary",
      "likely_causes",
      "next_question",
      "knowledge_refs",
      "contains_full_solution"
    ],
    "properties": {
      "verdict_summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "likely_causes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 5,
        "items": {
          "$ref": "#/definitions/LikelyCause"
        }
      },
      "next_question": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "knowledge_refs": {
        "type": "array",
        "uniqueItems": true,
        "maxItems": 10,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "contains_full_solution": {
        "type": "boolean",
        "enum": [
          false
        ]
      }
    }
  },
  "ExplanationSection": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "explanation",
      "code_refs"
    ],
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "explanation": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "code_refs": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "string",
          "pattern": "^(?:L[1-9][0-9]*)(?:-L[1-9][0-9]*)?$"
        }
      }
    }
  },
  "Complexity": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "time",
      "space",
      "assumptions"
    ],
    "properties": {
      "time": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "space": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "assumptions": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    }
  },
  "CodeExplanationResult": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "summary",
      "sections",
      "complexity",
      "improvement_directions",
      "contains_full_solution"
    ],
    "properties": {
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "sections": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "$ref": "#/definitions/ExplanationSection"
        }
      },
      "complexity": {
        "$ref": "#/definitions/Complexity"
      },
      "improvement_directions": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "contains_full_solution": {
        "type": "boolean",
        "enum": [
          false
        ]
      }
    }
  },
  "SocraticHintResult": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "hint_level",
      "question",
      "focus",
      "next_hint_available_at",
      "contains_full_solution"
    ],
    "properties": {
      "hint_level": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
      },
      "question": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "focus": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "next_hint_available_at": {
        "type": [
          "string",
          "null"
        ],
        "format": "date-time"
      },
      "contains_full_solution": {
        "type": "boolean",
        "enum": [
          false
        ]
      }
    }
  },
  "PathStepExplanation": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "order",
      "knowledge_code",
      "reason"
    ],
    "properties": {
      "order": {
        "type": "integer",
        "minimum": 1
      },
      "knowledge_code": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "reason": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  },
  "LearningPathExplanationResult": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "path_id",
      "overview",
      "steps",
      "next_action",
      "contains_full_solution"
    ],
    "properties": {
      "path_id": {
        "type": "string",
        "format": "uuid"
      },
      "overview": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": {
          "$ref": "#/definitions/PathStepExplanation"
        }
      },
      "next_action": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "contains_full_solution": {
        "type": "boolean",
        "enum": [
          false
        ]
      }
    }
  },
  "FeedbackRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "rating"
    ],
    "properties": {
      "rating": {
        "type": "string",
        "enum": [
          "helpful",
          "too_long",
          "too_hard",
          "need_simpler",
          "incorrect"
        ]
      },
      "comment": {
        "type": "string",
        "maxLength": 2000
      }
    }
  },
  "FeedbackEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "error",
      "data",
      "request_id"
    ],
    "properties": {
      "error": {
        "type": [
          "string",
          "null"
        ]
      },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "rating",
          "updated_time"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "rating": {
            "type": "string",
            "enum": [
              "helpful",
              "too_long",
              "too_hard",
              "need_simpler",
              "incorrect"
            ]
          },
          "updated_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "request_id": {
        "type": "string"
      }
    }
  },
  "ErrorEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "error",
      "data",
      "request_id"
    ],
    "properties": {
      "error": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]+$"
      },
      "data": {
        "$ref": "#/definitions/ErrorData"
      },
      "request_id": {
        "type": "string"
      }
    }
  },
  "ErrorData": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "message",
      "retryable",
      "details"
    ],
    "properties": {
      "message": {
        "type": "string"
      },
      "retryable": {
        "type": "boolean"
      },
      "details": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "CreateConversationRequest": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "problem_id",
      "service_type"
    ],
    "properties": {
      "problem_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "service_type": {
        "type": "string",
        "enum": [
          "socratic_hint"
        ]
      }
    }
  },
  "Conversation": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "conversation_id",
      "problem_id",
      "service_type",
      "status",
      "hint_level",
      "max_hint_level",
      "hint_available_time",
      "first_opened_time"
    ],
    "properties": {
      "conversation_id": {
        "type": "string",
        "format": "uuid"
      },
      "problem_id": {
        "type": "string"
      },
      "service_type": {
        "type": "string",
        "enum": [
          "socratic_hint"
        ]
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "closed",
          "expired"
        ]
      },
      "hint_level": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3
      },
      "max_hint_level": {
        "type": "integer",
        "enum": [
          3
        ]
      },
      "hint_available_time": {
        "type": "string",
        "format": "date-time"
      },
      "first_opened_time": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "ConversationEnvelope": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "error",
      "data",
      "request_id"
    ],
    "properties": {
      "error": {
        "type": [
          "string",
          "null"
        ]
      },
      "data": {
        "$ref": "#/definitions/Conversation"
      },
      "request_id": {
        "type": "string"
      }
    }
  }
}
