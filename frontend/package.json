{
  "name": "onlinejudge",
  "version": "2.7.6",
  "description": "onlinejudge front end",
  "author": "zemal <rawidn@163.com>",
  "private": true,
  "scripts": {
    "dev": "node build/dev-server.mjs",
    "dev:mock": "node build/dev-server.mjs --mock",
    "start": "npm run dev",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src build tests *.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "0.18.1",
    "browser-detect": "0.2.28",
    "echarts": "3.8.5",
    "font-awesome": "4.7.0",
    "highlight.js": "9.18.5",
    "katex": "0.10.2",
    "moment": "2.30.1",
    "monaco-editor": "0.55.1",
    "papaparse": "4.6.3",
    "raven-js": "3.27.2",
    "screenfull": "3.3.3",
    "tar-simditor": "3.0.5",
    "tar-simditor-markdown": "1.2.3",
    "jquery": "3.1.1",
    "codemirror": "5.65.21",
    "vue": "3.5.43",
    "vue-router": "4.6.4",
    "vuex": "4.1.0",
    "vue-i18n": "11.4.12",
    "view-ui-plus": "1.3.24",
    "element-plus": "2.14.6",
    "vue-cropper": "1.1.4",
    "simple-module": "file:vendor/simple-module",
    "simple-hotkeys": "file:vendor/simple-hotkeys",
    "simple-uploader": "file:vendor/simple-uploader"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/test-utils": "2.5.1",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "jsdom": "30.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.11.0",
    "vue-eslint-parser": "10.4.1",
    "globals": "17.12.0",
    "express": "4.22.2",
    "less": "4.9.1"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "Safari >= 16.4"
  ],
  "overrides": {
    "tar-simditor@3.0.5": {
      "simple-hotkeys": "$simple-hotkeys",
      "simple-module": "$simple-module",
      "simple-uploader": "$simple-uploader"
    }
  }
}
